<% include ../../template-backoffice/header.ejs %>
  <!-- Main Content -->
  <div class="main-content">
    <section class="section">
      <div class="w-100" style="padding: 0 30px;">
        <div class="section-header">
          <h1>Data Anggota</h1>
          <div class="section-header-breadcrumb">
            <div class="breadcrumb-item active"><a href="/backoffice">Dashboard</a></div>
            <div class="breadcrumb-item">Data</div>
          </div>
        </div>
      </div>

      <div class="section-body">
        <div class="row">
          <div class="col-lg-12 col-xl-12">
            <div class="card">
              <div class="card-header">
                <a href="/anggota/insert" class="btn btn-primary custom-btn-card-header"><i class="fas fa-plus"></i> Tambah Data</a>
              </div>
              <div class="card-body">
                <div class="table-responsive">
                  <table class="table table-bordered table-striped table-hover" id="list-data">
                    <thead>
                    <tr>
                      <th class="header">No.</th>
                      <th class="header">No. Anggota</th>
                      <th class="header">Nama Perusahaan</th>
                      <th class="header">Penanggung Jawab</th>
                      <th class="header">Kota</th>
                      <th class="header">Status</th>
                      <th class="header">Option</th>
                    </tr>
                  </thead>

                  <tbody>

                  </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
  <footer class="main-footer">
    <div class="footer-left">
      <% include ../../template-backoffice/copyright-left.ejs %>
    </div>
    <div class="footer-right">
      <% include ../../template-backoffice/copyright-right.ejs %>
    </div>
  </footer>
<% include ../../template-backoffice/footer.ejs %>

<script type="text/javascript">
    var rooturl = ''
    let data_table  =$('#list-data').DataTable({
      "language": {
          "sProcessing":   "Sedang memproses...",
          "sLengthMenu":   "_MENU_",
          "sZeroRecords":  "Tidak ditemukan data yang sesuai",
          "sInfo":         "Menampilkan _START_ sampai _END_ dari _TOTAL_ entri",
          "sInfoEmpty":    "Menampilkan 0 sampai 0 dari 0 entri",
          "sInfoFiltered": "(disaring dari _MAX_ entri keseluruhan)",
          "sInfoPostFix":  "",
          "sUrl":          "",
          "oPaginate": {
            "sFirst":    "Pertama",
            "sPrevious": "Sebelumnya",
            "sNext":     "Selanjutnya",
            "sLast":     "Terakhir"
          }
      },
      "processing": true,
      "ajax":  `${rooturl}/anggota/list`,
      "columns": [
        { "data": null},
        { "data": "no_anggota"},
        { "data": "nama_perusahaan"},
        { "data": "penanggung_jawab"},
        { "data": "kota"},
        { "data": "status_keanggotaan"},
        { "data": "id",render: function(data){
          let a = ''
          if (data) {
            a = `
                <ul class="list-inline mb-0" style="text-align:center">
                  <li class="list-inline-item"><a href="${rooturl}/anggota/edit/${data}" class="btn btn-warning"><i class="fas fa-edit"></i></a></li>
                  <li class="list-inline-item"><button  onclick="hapus(${data})"  class="btn btn-danger"><i class="fa fa-trash"></i></button></li>
                </ul>`
          }
          return `<td><center>${a}</center></td>`
        }},
      ],
      "columnDefs": [
        { "width": "40px", "targets": 0},
        { "width": "160px", "targets": 6}
      ],
    });

    data_table.on( 'draw.dt', function () {
      let PageInfo = $('#list-data').DataTable().page.info();
      data_table.column(0, { page: 'current' }).nodes().each( function (cell, i) {
        cell.innerHTML = i + 1 + PageInfo.start;
      });
    });

    async function hapus(id) {
      const willDelete = await swal({
        title: "Hapus Data",
        text: "Apakah anda akan menghapus data ini?",
        icon: "warning",
        dangerMode: true,
        buttons: ["Tidak", "Ya"],
      });

      if ( willDelete) {
        $.get(rooturl+"/anggota/hapus/"+id).then(function (hsl) {
          swal({title:text_delete.title,text:text_delete.text, icon: text_delete.icon, type:text_delete.type})
          data_table.ajax.url(rooturl+"/anggota/list").load();
        })
      }
    }
</script>