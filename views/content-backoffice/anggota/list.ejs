<!-- Modal Import Excel -->
<div class="modal fade modal-import-excel" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Import Data Anggota dari Excel</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <form id="formImportExcel" enctype="multipart/form-data">
          <div class="form-group">
            <label for="file_excel">File Excel (.xlsx)</label>
            <input type="file" class="form-control" id="file_excel" name="file_excel" accept=".xlsx, .xls" required>
            <small class="form-text text-muted">Pastikan file Excel memiliki format yang sesuai dengan template.</small>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Tutup</button>
        <button type="button" class="btn btn-primary" onclick="submitImportExcel()">Import</button>
      </div>
    </div>
  </div>
</div>

<script type="text/javascript">
    var rooturl = ''
window.onload = async function (params) {
     let data = await $.get('/anggota/statistics/simple')
let data2 = await $.get('/anggota/statistics/retribusi/'+new Date().getFullYear())
$('#total_anggota').html(data.data.total_anggota)
$('#aktif').html(data.data.aktif)
$('#non_aktif').html(data.data.non_aktif)
for (let i = 0; i < data.data.berdasarkan_kualifikasi.length; i++) {
  let a = data.data.berdasarkan_kualifikasi[i]
  $('#kualifikasi_'+a.kualifikasi).html(a.jumlah)
  
}
}
    let data_table  =$('#list-data').DataTable({
      "language": {
          "sSearch": "Cari:", // <-- Tambahkan baris ini untuk label search
          "sSearchPlaceholder": "Ketik kata kunci...", // (Opsional) Teks placeholder di dalam kotak input
          "sProcessing":   "Sedang memproses...",
          "sLengthMenu":   "_MENU_",
          "sZeroRecords":  "Tidak ditemukan data yang sesuai",
          "sInfo":         "Menampilkan _START_ sampai _END_ dari _TOTAL_ entri",
          "sInfoEmpty":    "Menampilkan 0 sampai 0 dari 0 entri",
          "sInfoFiltered": "(disaring dari _MAX_ entri keseluruhan)",
          "sInfoPostFix":  "",
          "sUrl":          "",
          "oPaginate": {
            "sFirst":    "Pertama",
            "sPrevious": "Sebelumnya",
            "sNext":     "Selanjutnya",
            "sLast":     "Terakhir"
          }
      },
      "processing": true,
      "ajax":  `${rooturl}/anggota/list`,
      "columns": [
        { "data": null},
        { "data": "nama_perusahaan"},
        { "data": "penanggung_jawab"},
        { "data": "telepon"},
        { "data": "kualifikasi",render:function(data){return data=='B'?'BESAR':data=='M'?'MENENGAH':'KECIL'}},
        { "data": "tunggakan",render : function (params) {
          return new Intl.NumberFormat('id-ID').format(params)
        }},
        { "data": "status"},
        { "data": "id",render: function(data){
          let a = ''
          if (data) {
            a = `
                <ul class="list-inline" style='text-align:center;margin-bottom:5px'>
                  <li class='list-inline-item'><a href='${rooturl}/anggota/edit/${data}' class='btn btn-warning'><i class='fas fa-edit'></i></a></li>
                  <li class="list-inline-item"><button  onclick="hapus(${data})"  class="btn btn-danger"><i class="fa fa-trash"></i></button></li>
                  
                  
                </ul><ul class="list-inline" style='text-align:center;margin-bottom:0;'>
                  <li class="list-inline-item"><a href="${rooturl}/anggota/spesialisasi/${data}" class="btn btn-info"><i class="fas fa-tags"></i></a></li>  
                  <li class="list-inline-item"><a href="${rooturl}/anggota/penghargaan/${data}" class="btn btn-dark"><i class="fas fa-medal"></i></a></li>  
                  <li class="list-inline-item"><a href="${rooturl}/anggota/pembayaran/${data}" class="btn btn-success"><i class="fas fa-receipt"></i></a></li>  
                  </ul>`
          }
          return `<td><center>${a}</center></td>`
        }},
      ],
      "columnDefs": [
        { "width": "40px", "targets": 0},
        { "width": "160px", "targets": 7}
      ],
    });

    // Initialize Select2 for search fields
    $('.select2').select2({
        theme: 'bootstrap4',
        width: '100%'
    });

    data_table.on( 'draw.dt', function () {
      let PageInfo = $('#list-data').DataTable().page.info();
      data_table.column(0, { page: 'current' }).nodes().each( function (cell, i) {
        cell.innerHTML = i + 1 + PageInfo.start;
      });
    });

    async function hapus(id) {
      const willDelete = await swal({
        title: "Hapus Data",
        text: "Apakah anda akan menghapus data ini?",
        icon: "warning",
        dangerMode: true,
        buttons: ["Tidak", "Ya"],
      });

      if ( willDelete) {
        $.get(rooturl+"/anggota/hapus/"+id).then(function (hsl) {
          swal({title:text_delete.title,text:text_delete.text, icon: text_delete.icon, type:text_delete.type})
          data_table.ajax.url(rooturl+"/anggota/list").load();
        })
      }
    }

    // Filter functions
    function applyFilters() {
        const namaPerusahaan = $('#searchNamaPerusahaan').val();
        const kota = $('#searchKota').val();
        const kualifikasi = $('#searchKualifikasi').val();
        const status = $('#searchStatus').val();
        const spesialisasi = $('#searchSpesialisasi').val();

        // Build URL with filter parameters
        let url = rooturl + '/anggota/list?';

        if (namaPerusahaan) {
            url += 'nama_perusahaan=' + encodeURIComponent(namaPerusahaan) + '&';
        }
        if (kota) {
            url += 'kota=' + encodeURIComponent(kota) + '&';
        }
        if (kualifikasi) {
            url += 'kualifikasi=' + encodeURIComponent(kualifikasi) + '&';
        }
        if (status) {
            url += 'status=' + encodeURIComponent(status) + '&';
        }
        if (spesialisasi && spesialisasi.length > 0) {
            spesialisasi.forEach(function(spes) {
                url += 'spesialisasi=' + encodeURIComponent(spes) + '&';
            });
        }

        // Remove trailing '&'
        url = url.replace(/&$/, '');

        // Reload table with new URL
        data_table.ajax.url(url).load();
    }

    function resetFilters() {
        $('#searchNamaPerusahaan').val('');
        $('#searchKota').val('').trigger('change');
        $('#searchKualifikasi').val('').trigger('change');
        $('#searchStatus').val('').trigger('change');
        $('#searchSpesialisasi').val('').trigger('change');

        // Reload table without filters
        data_table.ajax.url(rooturl + '/anggota/list').load();
    }

    async function submitImportExcel() {
      const fileInput = $('#file_excel')[0];

      if (!fileInput.files || !fileInput.files[0]) {
        swal({title:"Error",text:"Pilih file Excel terlebih dahulu", icon:"error", type:"error"});
        return;
      }

      const willImport = await swal({
        title: "Import Data",
        text: "Apakah anda akan import data dari Excel? Data yang sudah ada akan diupdate.",
        icon: "warning",
        dangerMode: true,
        buttons: ["Tidak", "Ya"],
      });

      if (willImport) {
        let formData = new FormData();
        formData.append('file_excel', fileInput.files[0]);

        $.ajax({
          type: 'POST',
          enctype: 'multipart/form-data',
          url: rooturl + '/anggota/import',
          data: formData,
          processData: false,
          contentType: false,
          success: function(data) {
            $('.modal-import-excel').modal('hide');
            $('#formImportExcel')[0].reset();
            swal({title:data.status == 200 ? "Sukses" : "Error", text:data.message, icon:data.status == 200 ? "success" : "error", type:data.status == 200 ? "success" : "error"});
            if (data.status == 200) {
              data_table.ajax.url(rooturl+"/anggota/list").load();
            }
          },
          error: function(data) {
            swal({title:"Error", text:"Terjadi kesalahan saat import data", icon:"error", type:"error"});
          }
        });
      }
    }
</script>