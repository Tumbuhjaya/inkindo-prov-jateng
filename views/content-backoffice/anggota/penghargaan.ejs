            <div class="breadcrumb-item active"><a href="/backoffice">Dashboard</a></div>
            <div class="breadcrumb-item active"><a href="/anggota">Data</a></div>
            <div class="breadcrumb-item">Penghargaan</div>
          </div>
        </div>
      </div>

      <div class="section-body">
	        <div class="row">
	          <div class="col-12 col-lg-12 col-xl-12">
	            <div class="card">
	              <div class="card-body">
	                <div class="row">
	                  <div class="col-12">
	                    <div class="form-group row mb-0">
	                      <label class="col-sm-3 col-form-label">Tahun</label>
	                      <div class="col-sm-9">
	                        <select name="" class="form-control select2" id="">
	                          <option value="">-- Pilih --</option>
	                        </select>
	                      </div>
	                    </div>

						<hr>

						<div class="form-group row mb-0">
	                      <label class="col-sm-3 col-form-label">Hasil Karya</label>
	                      <div class="col-sm-9">
	                        <input type="text" class="form-control" name="" id="">
	                      </div>
	                    </div>

						<hr>

						<div class="form-group row mb-0">
	                      <label class="col-sm-3 col-form-label">Upload Piagam Penghargaan</label>
	                      <div class="col-sm-9">
	                        <input type="file" class="form-control" name="" id="">
	                      </div>
	                    </div>

						<hr>
						
	                    <div class="form-group row mt-3 mb-0">
	                      <div class="col-sm-9 offset-sm-3">
	                        <div id="button_submit">
	                          <button class="btn btn-primary mb-0 btn-lg" onclick="submit()">Submit</button>
	                        </div>
	                      </div>
	                    </div>
	                  </div>
	                </div>

	                <div class="row">
	                  <div class="col-12">
	                    <hr>
	                  </div>
	                </div>

