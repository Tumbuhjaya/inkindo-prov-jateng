	                        <tr>
	                          <th>No.</th>
	                          <th>Tahun</th>
	                          <th>Hasil Karya</th>
	                          <th>Piagam Penghargaan</th>
	                          <th>Option</th>
	                        </tr>
	                      </thead>

	                      <tbody id="">
	                        <!-- Data will be loaded here -->
	                      </tbody>
	                    </table>
	                  </div>
	                </div>

	              </div>
	            </div>
	          </div>
	        </div>
	      </div>

    </section>
  </div>

  <footer class="main-footer">
    <div class="footer-left">
      <% include ../../template-backoffice/copyright-left.ejs %>
    </div>
    <div class="footer-right">
      <% include ../../template-backoffice/copyright-right.ejs %>
    </div>
  </footer>

<% include ../../template-backoffice/footer.ejs %>
<script type="text/javascript">
  var rooturl = ''

  async function submit() {
    const will_insert = await swal({
      title: "Tambah Data",
      text: "Apakah anda akan menambahkan data ini?",
      icon: "warning",
      dangerMode: true,
      buttons: ["Tidak", "Ya"],
    });

    if ( will_insert) {
      $('#button_submit').empty()
      $('#button_submit').append('<button class="btn btn-primary btn-embossed" disabled>Simpan</button>')
      
      let formData = new FormData();    
      // nama kolom db
      let arr = ['NamaKolomDb1', 'NamaKolomDb2', 'NamaKolomDb3']
      for (let i = 0; i < arr.length; i++) {
        if (arr[i].substring(0,4)=='foto') {
          if ( $(`#`+arr[i])[0].files[0]){
            formData.append(arr[i], $(`#`+arr[i])[0].files[0]);
          } 
        }
        // else if (arr[i].substring(0,3)=='ket'){        
        //   formData.append(arr[i] ,CKEDITOR.instances[arr[i]].getData())
        // }
        else{
          formData.append(arr[i],$('#'+arr[i]).val())
        }
      }

      $.ajax({
        type: 'POST',
        enctype: 'multipart/form-data',
        url: rooturl+'/api_basic/insert',
        data: formData,
        processData: false,
        contentType: false,
        success: function(data) {
          swal({title:text_insert.title,text:text_insert.text, icon: text_insert.icon, type:text_insert.type})
          window.location.href = rooturl+'/manajemen_basic';
        },error: function(data) {
          swal({title:text_error.title,text:text_error.text, icon: text_error.icon, type:text_error.type})
        }
      })      
    } 
  }
</script>