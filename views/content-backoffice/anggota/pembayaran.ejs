<% include ../../template-backoffice/header.ejs %>
		  <div class="main-content">
		    <section class="section">
		      <div class="w-100" style="padding: 0 30px;">
		        <div class="section-header" style="border-radius: 0.25rem;">
		          <h1 style="line-height: 25px;">Pembayaran Iuran <br/><small><%= (typeof anggota !== 'undefined' && anggota) ? anggota.nama_perusahaan : 'Nama Perusahaan' %></small></h1>
		          <div class="section-header-breadcrumb">
		            <div class="breadcrumb-item active"><a href="/backoffice">Dashboard</a></div>
		            <div class="breadcrumb-item active"><a href="/anggota">Data Anggota</a></div>
		            <div class="breadcrumb-item">Pembayaran Iuran</div>
		          </div>
		        </div>
		      </div>

		      <div class="section-body">
		        <div class="row">
		          <div class="col-12 col-lg-12 col-xl-12">
		            <div class="card">
		              <div class="card-header">
		                <button class="btn btn-primary" data-toggle="modal" data-target="#modalPembayaran" onclick="resetForm();"><i class="fas fa-plus"></i> Tambah Data Pembayaran</button>
		                <a href="/anggota" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Kembali</a>
		              </div>
		              <div class="card-body">
		                <div class="table-responsive">
	                  <table class="table table-bordered table-striped table-hover" id="list-pembayaran">
	                    <thead>
	                    <tr>
	                      <th style="width: 40px;">No.</th>
	                      <th>Tahun</th>
	                      <th>Tanggal Pembayaran</th>
	                      <th>Nominal (Rp)</th>
	                      <th>Status</th>
	                      <th style="width: 120px;">Option</th>
	                    </tr>
	                  </thead>

	                  <tbody id="pembayaranTableBody">

	                  </tbody>
	                  </table>
	                </div>
		              </div>
		            </div>
		          </div>
		        </div>
		      </div>

		    </section>
		  </div>

		  <footer class="main-footer">
		    <div class="footer-left">
		      <% include ../../template-backoffice/copyright-left.ejs %>
		    </div>
		    <div class="footer-right">
		      <% include ../../template-backoffice/copyright-right.ejs %>
		    </div>
		  </footer>

		  <!-- Modal Pembayaran -->
			<div class="modal fade" id="modalPembayaran" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
			<div class="modal-dialog modal-lg modal-dialog-centered">
				<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="modalTitle">Tambah Pembayaran Iuran</h5>
					<button type="button" class="close" data-dismiss="modal" aria-label="Close">
					<span aria-hidden="true">&times;</span>
					</button>
				</div>
				<div class="modal-body">
					<form id="formPembayaran">
						<input type="hidden" id="pembayaranId" name="id">
						<div class="row">
							<div class="col-md-12 col-lg-12">
								<div class="form-group row mb-0">
		                      <label class="col-sm-3 col-form-label">Tahun <span class="text-danger">*</span></label>
		                      <div class="col-sm-9">
		                        <select class="form-control select2" id="tahun" name="tahun" required>
		                          <option value="">-- Pilih Tahun --</option>
		                          <option value="2020">2020</option>
		                          <option value="2021">2021</option>
		                          <option value="2022">2022</option>
		                          <option value="2023">2023</option>
		                          <option value="2024">2024</option>
		                          <option value="2025">2025</option>
		                          <option value="2026">2026</option>
		                          <option value="2027">2027</option>
		                          <option value="2028">2028</option>
		                          <option value="2029">2029</option>
		                          <option value="2030">2030</option>
		                        </select>
		                      </div>
		                    </div>

							<hr>

							<div class="form-group row mb-0">
		                      <label class="col-sm-3 col-form-label">Tanggal Pembayaran <span class="text-danger">*</span></label>
		                      <div class="col-sm-9">
		                        <input type="date" class="form-control" name="tanggal_pembayaran" id="tanggal_pembayaran" required>
		                      </div>
		                    </div>

							<hr>

							<div class="form-group row mb-0">
		                      <label class="col-sm-3 col-form-label">Nominal Retribusi (Rp) <span class="text-danger">*</span></label>
		                      <div class="col-sm-9">
		                        <!-- <input type="number" class="form-control" name="retribusi" style="text-align: right" id="retribusi" placeholder="Contoh: 1500000" required> -->
<input type="text" class="form-control input-with-thousand-separator" 
       name="retribusi" id="retribusi" 
       placeholder="Contoh: 1.500.000" 
       oninput="formatRupiah(this)" 
       required>
								</div>
		                    </div>

							<hr>

							<div class="form-group row mb-0">
		                      <label class="col-sm-3 col-form-label">Status Pembayaran <span class="text-danger">*</span></label>
		                      <div class="col-sm-9">
		                        <select class="form-control select2" id="status" name="status" required>
		                          <option value="">-- Pilih Status --</option>
		                          <option value="0">Belum Lunas</option>
		                          <option value="1">Lunas</option>
		                        </select>
		                      </div>
		                    </div>

							<hr>

							<div class="form-group row mb-0">
		                      <label class="col-sm-3 col-form-label">Upload Bukti Pembayaran</label>
		                      <div class="col-sm-9">
		                        <input type="file" class="form-control" name="foto_1" id="foto_1" accept="image/*">
		                        <small class="form-text text-muted">Format: JPG, PNG, JPEG. Maksimal 2MB.</small>
		                        <div id="previewFoto" style="margin-top: 10px;"></div>
		                      </div>
		                    </div>
							</div>
						</div>
					</form>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-dark" data-dismiss="modal">Tutup</button>
					<button type="button" class="btn btn-primary" onclick="submitPembayaran()">Simpan</button>
				</div>
				</div>
			</div>
			</div>

			<!-- Modal View Bukti Pembayaran -->
			<div class="modal fade" id="modalViewBukti" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
			<div class="modal-dialog modal-lg modal-dialog-centered">
				<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">Bukti Pembayaran</h5>
					<button type="button" class="close" data-dismiss="modal" aria-label="Close">
					<span aria-hidden="true">&times;</span>
					</button>
				</div>
				<div class="modal-body text-center">
					<img id="imageBukti" src="" alt="Bukti Pembayaran" style="max-width: 100%; max-height: 500px;">
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-dark" data-dismiss="modal">Tutup</button>
				</div>
				</div>
			</div>
			</div>
		<% include ../../template-backoffice/footer.ejs %>

		<script type="text/javascript">
			var rooturl = '';
			var anggotaId = `<%= (typeof anggotaId !== 'undefined') ? anggotaId : '' %>`;
			var data_table;

			$(document).ready(function() {
				// Initialize DataTable
				data_table = $('#list-pembayaran').DataTable({
					"language": {
						"sProcessing": "Sedang memproses...",
						"sLengthMenu": "_MENU_",
						"sZeroRecords": "Tidak ditemukan data yang sesuai",
						"sInfo": "Menampilkan _START_ sampai _END_ dari _TOTAL_ entri",
						"sInfoEmpty": "Menampilkan 0 sampai 0 dari 0 entri",
						"sInfoFiltered": "(disaring dari _MAX_ entri keseluruhan)",
						"sInfoPostFix": "",
						"sUrl": "",
						"oPaginate": {
							"sFirst": "Pertama",
							"sPrevious": "Sebelumnya",
							"sNext": "Selanjutnya",
							"sLast": "Terakhir"
						}
					},
					"processing": true,
					"ajax": {
						"url": rooturl + '/anggota/pembayaran/' + anggotaId + '/list',
						"dataSrc": function(json) {
							return json.data || [];
						}
					},
					"columns": [
						{ "data": null },
						{ "data": "tahun" },
						{
							"data": "tanggal_pembayaran",
							"render": function(data) {
								if (!data) return '-';
								const date = new Date(data);
								return date.toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric' });
							}
						},
						{
							"data": "retribusi",
							"render": function(data) {
								if (!data) return '-';
								return new Intl.NumberFormat('id-ID').format(data);
							}
						},
						{
							"data": "status",
							"render": function(data) {
								if (data == 1) {
									return '<span class="badge badge-success">Lunas</span>';
								} else {
									return '<span class="badge badge-danger">Belum Lunas</span>';
								}
							}
						},
						{
							"data": "id",
							"render": function(data, type, row) {
								let buttons = '<ul class="list-inline mb-0">';

								// Edit button
								buttons += '<li class="list-inline-item"><button onclick="editPembayaran(' + data + ')" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i></button></li>';

								// View proof button if photo exists
								if (row.foto_1) {
									buttons += '<li class="list-inline-item"><button onclick="viewBukti(\'' + row.foto_1 + '\')" class="btn btn-info btn-sm"><i class="fas fa-receipt"></i></button></li>';
								}

								// Delete button
								buttons += '<li class="list-inline-item"><button onclick="hapusPembayaran(' + data + ')" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i></button></li>';

								buttons += '</ul>';
								return buttons;
							}
						},
					],
					"columnDefs": [
						{ "width": "40px", "targets": 0 },
						{ "width": "120px", "targets": 5 }
					],
				});

				// Add row numbers
				data_table.on('draw.dt', function() {
					let PageInfo = $('#list-pembayaran').DataTable().page.info();
					data_table.column(0, { page: 'current' }).nodes().each(function(cell, i) {
						cell.innerHTML = i + 1 + PageInfo.start;
					});
				});

				// Initialize Select2
				$('.select2').select2();
			});

		function formatRupiah(input) {
    // Hapus semua karakter non-digit
    let value = input.value.replace(/\D/g, '');
    
    // Jika kosong, set value kosong
    if (value === '') {
        input.value = '';
        return;
    }
    
    // Konversi ke number
    let number = parseInt(value);
    
    // Format dengan pemisah ribuan
    input.value = number.toLocaleString('id-ID');
}

// Fungsi untuk mendapatkan nilai integer dari input yang diformat
function getRawValue(inputId) {
    const element = document.getElementById(inputId);
    if (!element) return 0;
    
    // Hapus semua karakter non-digit
    const raw = element.value.replace(/\D/g, '');
    return raw === '' ? 0 : parseInt(raw);
}
function resetForm() {
    $('#formPembayaran')[0].reset();
    $('#pembayaranId').val('');
    $('#modalTitle').text('Tambah Pembayaran Iuran');
    $('#previewFoto').empty();
    // Reset input retribusi menjadi kosong
    $('#retribusi').val('');
}
// Modifikasi fungsi submitPembayaran
function submitPembayaran() {
    const formData = new FormData();
    const pembayaranId = $('#pembayaranId').val();
    const isEdit = pembayaranId ? true : false;

    // Get form data
    const tahun = $('#tahun').val();
    const tanggal_pembayaran = $('#tanggal_pembayaran').val();
    // Ambil nilai integer dari input yang diformat
    const retribusi = getRawValue('retribusi');
    const status = $('#status').val();

    // Validation
    if (!tahun || !tanggal_pembayaran || !retribusi || status === '') {
        swal({
            title: "Error",
            text: "Semua field wajib diisi!",
            icon: "error",
            type: "error"
        });
        return;
    }

    // Add form data
    formData.append('tahun', tahun);
    formData.append('tanggal_pembayaran', tanggal_pembayaran);
    formData.append('retribusi', retribusi); // Kirim integer
    formData.append('status', status);
				// Add file if exists
				if ($('#foto_1')[0].files[0]) {
					formData.append('foto_1', $('#foto_1')[0].files[0]);
				}

				const confirmMsg = isEdit ? "Apakah anda akan mengupdate data ini?" : "Apakah anda akan menambahkan data ini?";

				swal({
					title: "Konfirmasi",
					text: confirmMsg,
					icon: "warning",
					dangerMode: true,
					buttons: ["Tidak", "Ya"],
				}).then((willSubmit) => {
					if (willSubmit) {
						const url = isEdit ? rooturl + '/anggota/pembayaran/' + pembayaranId + '/update' : rooturl + '/anggota/pembayaran/' + anggotaId + '/save';
						const method = 'POST';

						$.ajax({
							type: method,
							enctype: 'multipart/form-data',
							url: url,
							data: formData,
							processData: false,
							contentType: false,
							success: function(data) {
								if (data.status === 200) {
									swal({
										title: "Sukses",
										text: isEdit ? "Data berhasil diupdate" : "Data berhasil ditambahkan",
										icon: "success",
										type: "success"
									});
									$('#modalPembayaran').modal('hide');
									data_table.ajax.reload(null, false);
								} else {
									swal({
										title: "Error",
										text: data.message || "Terjadi kesalahan",
										icon: "error",
										type: "error"
									});
								}
							},
							error: function(data) {
								swal({
									title: "Error",
									text: "Terjadi kesalahan saat memproses data",
									icon: "error",
									type: "error"
								});
							}
						});
					}
				});
			}

			function editPembayaran(id) {
    $.get(rooturl + '/anggota/pembayaran-detail/' + id).then(function(response) {
        if (response.status === 200 && response.data) {
            const data = response.data;

            // Set form values
            $('#pembayaranId').val(data.id);
            $('#tahun').val(data.tahun).trigger('change');
            $('#tanggal_pembayaran').val(data.tanggal_pembayaran ? data.tanggal_pembayaran.split('T')[0] : '');
            
            // Format retribusi dengan pemisah ribuan
            if (data.retribusi) {
                $('#retribusi').val(Number(data.retribusi).toLocaleString('id-ID'));
            }
            
            $('#status').val(data.status).trigger('change');

						// Show existing photo if exists
						if (data.foto_1) {
							$('#previewFoto').html('<img src="/foto/' + data.foto_1 + '" style="max-width: 200px; margin-top: 10px;">');
						}

						// Update modal title
						$('#modalTitle').text('Edit Pembayaran Iuran');

						// Show modal
						$('#modalPembayaran').modal('show');
					} else {
						swal({
							title: "Error",
							text: "Data tidak ditemukan",
							icon: "error",
							type: "error"
						});
					}
				}).fail(function() {
					swal({
						title: "Error",
						text: "Gagal mengambil data",
						icon: "error",
						type: "error"
					});
				});
			}

			function hapusPembayaran(id) {
				swal({
					title: "Hapus Data",
					text: "Apakah anda akan menghapus data ini?",
					icon: "warning",
					dangerMode: true,
					buttons: ["Tidak", "Ya"],
				}).then((willDelete) => {
					if (willDelete) {
						$.get(rooturl + '/anggota/pembayaran/hapus/' + id).then(function(response) {
							if (response.status === 200) {
								swal({
									title: "Sukses",
									text: "Data berhasil dihapus",
									icon: "success",
									type: "success"
								});
								data_table.ajax.reload(null, false);
							} else {
								swal({
									title: "Error",
									text: response.message || "Gagal menghapus data",
									icon: "error",
									type: "error"
								});
							}
						}).fail(function() {
							swal({
								title: "Error",
								text: "Gagal menghapus data",
								icon: "error",
								type: "error"
							});
						});
					}
				});
			}

			function viewBukti(filename) {
				$('#imageBukti').attr('src', '/foto/' + filename);
				$('#modalViewBukti').modal('show');
			}

			// Preview image before upload
			$('#foto_1').change(function() {
				const file = this.files[0];
				if (file) {
					const reader = new FileReader();
					reader.onload = function(e) {
						$('#previewFoto').html('<img src="' + e.target.result + '" style="max-width: 200px; margin-top: 10px;">');
					}
					reader.readAsDataURL(file);
				}
			});
		</script>