          <hr>

          <div class="form-group row mb-0">
            <label class="col-sm-3 col-form-label">Memiliki Sertifikat Kode Etik</label>
            <div class="col-sm-9">
              <select name="memiliki_sertifikat_kode_etik" class="form-control select2" id="memiliki_sertifikat_kode_etik">
                <option value="">-- Pilih --</option>
