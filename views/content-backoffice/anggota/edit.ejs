<% include ../../template-backoffice/header.ejs %>
  <div class="main-content">
    <section class="section">
      <div class="w-100" style="padding: 0 30px;">
        <div class="section-header" style="border-radius: 0.25rem;">
          <h1>Edit Data Anggota</h1>
          <div class="section-header-breadcrumb">
            <div class="breadcrumb-item active"><a href="/backoffice">Dashboard</a></div>
            <div class="breadcrumb-item active"><a href="/anggota">Data</a></div>
            <div class="breadcrumb-item">Edit Data</div>
          </div>
        </div>
      </div>

      <% include ./komponen.ejs %>

    </section>
  </div>

  <footer class="main-footer">
    <div class="footer-left">
      <% include ../../template-backoffice/copyright-left.ejs %>
    </div>
    <div class="footer-right">
      <% include ../../template-backoffice/copyright-right.ejs %>
    </div>
  </footer>

<% include ../../template-backoffice/footer.ejs %>
<script type="text/javascript">
  let anggota = {}
  window.onload =async function (params) {
    await $.get(rooturl+'/anggota/list?id=<%=id%>').then(function (data) {
      anggota = data.data[0]
      console.log(anggota);
      for (const i in anggota) {
        if (Object.hasOwnProperty.call(anggota, i)) {
          if (i.substring(0,4)=='foto') {
            if (anggota[i]) {
              $('#lihat_'+i).append(`<a href="${rooturl}/foto/${anggota[i]}" target="_blank">Lihat Foto</a>`)
            }
          }else if(i=='status_keanggotaan' || i=='disyahkan' || i=='kode_etik' || i=='memiliki_sertifikat_kode_etik' || i=='kta_2020' || i=='kualifikasi'){
            $('#'+i).val(anggota[i]).select2()
          }else{
            $('#'+i).val(anggota[i])
          }
        }
      }
    })
  }
  async function submit() {
    const will_update = await swal({
      title: "Edit Data",
      text: "Apakah anda akan mengedit data ini?",
      icon: "warning",
      dangerMode: true,
      buttons: ["Tidak", "Ya"],
    });

    if ( will_update) {
      $('#button_submit').empty()
      $('#button_submit').append('<button class="btn btn-primary btn-embossed" disabled>Simpan</button>')
      let formData = new FormData();
      // nama kolom db
      let arr = ['no_anggota', 'nama_perusahaan', 'penanggung_jawab', 'gelar_pjbu', 'tanggal_lahir', 'alamat', 'kota', 'kode_kota', 'korwil', 'telepon', 'fax', 'nomor_hp_pjbu', 'email_kta', 'status_keanggotaan', 'disyahkan', 'kode_etik', 'yang_hadir', 'di_undang', 'pelantikan', 'no_sertifikat', 'waktu_penataran', 'memiliki_sertifikat_kode_etik', 'kta_2020', 'kualifikasi', 'jumlah_tunggakan', 'ket_tunggakan', 'foto']

      formData.append('id', anggota.id);

      for (let i = 0; i < arr.length; i++) {
        if (arr[i].substring(0,4)=='foto') {
          if ( $(`#`+arr[i])[0].files[0]){
            formData.append(arr[i], $(`#`+arr[i])[0].files[0]);
          }
        }else{
          if ($('#'+arr[i]).val()) {
            formData.append(arr[i],$('#'+arr[i]).val())
          }
        }
      }

      $.ajax({
        type: 'POST',
        enctype: 'multipart/form-data',
        url: rooturl+'/anggota/edit',
        data: formData,
        processData: false,
        contentType: false,
        success: function(data) {
          swal({title:text_edit.title,text:text_edit.text, icon: text_edit.icon, type:text_edit.type})
          window.location.href = rooturl+'/anggota';
        },error: function(data) {
          swal({title:text_error.title,text:text_error.text, icon: text_error.icon, type:text_error.type})
        }
      })
    }
  }
</script>