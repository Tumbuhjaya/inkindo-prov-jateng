let i = 0
      jateng_kemendagri_layer.eachLayer(function (layer) {
        try {

          // Generate warna unik berdasarkan kdpkab
          var cityColor = getColorByIndex(i)
          var kdpkab = layer.feature.properties.kdpkab;
          // var cityColor = getColorFromString(kdpkab || 'unknown');

          var style_jateng = {
            color: cityColor,
            weight: 2,
            opacity: 0.8,
            fillColor: cityColor,
            fillOpacity: 0.3
          };
          i++
          layer.setStyle(style_jateng);

          // Simpan warna asli untuk reset saat mouseout
          layer.originalStyle = {
            color: cityColor,
            weight: 2,
            opacity: 0.8,
            fillColor: cityColor,
            fillOpacity: 0.3
          };

          // Event listener untuk hover
          layer.on('mouseover', function (e) {
            try {
              var currentStyle = layer.options;
              this.setStyle({
                weight: 4,
                color: "#ff6600",
                fillColor: "#ff6600",
                fillOpacity: 0.5
              });

              // Ambil data anggota berdasarkan kdpkab
              var kdpkab = layer.feature.properties.kdpkab;

              if (kdpkab) {
                $.ajax({
                  type: "GET",
                  url: rooturl + "/peta/anggota_by_kota?kode_kota=" + kdpkab,
                  dataType: 'json',
                  success: function (anggotaData) {
                    if (anggotaData && anggotaData.status === 200) {
                      var popupContent = "<div style='max-height:300px; overflow-y:auto;'>";
