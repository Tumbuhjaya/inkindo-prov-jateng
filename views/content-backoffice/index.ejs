  '#B33771'  // Merah muda tua
];

// Fungsi untuk mendapatkan warna berdasarkan index
function getColorByIndex(index) {
  return colors[index % colors.length];
}
  // Fungsi untuk load GeoJSON jateng_kemendagri
  function loadGeoJsonjateng_kemendagri(data) {
    try {
      if (!data || !data.features) {
        console.log("No jateng_kemendagri data available");
        return;
      }

      jateng_kemendagri_layer.clearLayers();
      jateng_kemendagri_layer.addData(data);
