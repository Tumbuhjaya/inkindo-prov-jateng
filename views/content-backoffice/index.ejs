  //   }
  // });

  // Base layers
  var osm               = L.tileLayer('https://{s}.tile.osm.org/{z}/{x}/{y}.png', {
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
  });

  var Esri_WorldImagery = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
    attribution: 'Tiles &copy; Esri'
  });

  // Try to add Google layers, but handle errors gracefully
  var google_roadmap = null;
  var google_hybrid = null;
  var google_satelit = null;

  try {
    google_roadmap = L.gridLayer.googleMutant({
      type: 'roadmap'
    });

    google_hybrid = L.gridLayer.googleMutant({
      type: 'hybrid'
    });

    google_satelit = L.gridLayer.googleMutant({
      type: 'satellite'
    });
  } catch(e) {
    console.log("Google Maps layer not available:", e.message);
  }

  var RBI = null;
  try {
    RBI = L.esri.tiledMapLayer({
      url: "https://portal.ina-sdi.or.id/arcgis/rest/services/IGD/RupabumiIndonesia/MapServer"
    });
  } catch(e) {
    console.log("RBI layer not available:", e.message);
  }

  (function(){
    var originalInitTile = L.GridLayer.prototype._initTile
    L.GridLayer.include({
      _initTile: function (tile) {
        originalInitTile.call(this, tile);

        var tileSize = this.getTileSize();

        tile.style.width = tileSize.x + 1 + 'px';
        tile.style.height = tileSize.y + 1 + 'px';
      }
    });
  })();

  // Add default layer
  map.addLayer(osm);

  // TopoJSON support
  L.TopoJSON = L.GeoJSON.extend({
    addData: function(jsonData) {
      if (jsonData.type === "Topology") {
        for (key in jsonData.objects) {
          geojson = topojson.feature(jsonData, jsonData.objects[key]);
          L.GeoJSON.prototype.addData.call(this, geojson);
        }
      }
      else {
        L.GeoJSON.prototype.addData.call(this, jsonData);
      }
    }
  });

  // Layer inisialisasi
  var wellmaxzoom = 13;
  var jateng_kemendagri_layer = new L.GeoJSON();
  var inovasi = new L.TopoJSON();
  var inovasi_markers = L.markerClusterGroup();
  var popup = new L.popup();
  var cityLabels = []; // Array untuk menyimpan referensi ke label kota

  // Fungsi untuk load GeoJSON inovasi
  function loadGeoJsoninovasi(data) {
    try {
      if (!data || !data.objects) {
        console.log("No inovasi data available");
        return;
      }

      inovasi.clearLayers();
      inovasi.addData(data);
      inovasi.addTo(map);

      var i = 0;
      var labelnya = "";

      inovasi.eachLayer(function (layer) {
        var icon = new L.Icon.Default();
        icon.options.shadowSize = [0,0];
        layer.setIcon(icon);
        inovasi_markers.addLayer(layer);

        var popupContent = "Judul : <a href='inovasi/detail/"+layer.feature.properties.id+"'>"+layer.feature.properties.judul_inovasi+"</a>";
        popupContent = popupContent+"</br>Kategori : "+layer.feature.properties.sub_kategori;
        popupContent = popupContent+"</br>Jenis  : "+layer.feature.properties.jenisnya;

        var foto = layer.feature.properties.foto1;
        popupContent = popupContent+'<img src="/foto/'+foto+'" class="img-responsive" style="height: 100px;"> ';

        i++;

        layer.on("click", function (e) {
          popup.setLatLng(layer.getLatLng());
          popup.setContent(popupContent);
          map.openPopup(popup);
        });
      });

      map.removeLayer(inovasi);
      map.addLayer(inovasi_markers);
    } catch(e) {
      console.log("Error loading inovasi data:", e.message);
    }
  }

  // Fungsi untuk generate warna berdasarkan string (kdpkab)
  function getColorFromString(str) {
    // Buat hash dari string
    let hash = 0;
    for (let i = 0; i < str.length; i++) {
      hash = str.charCodeAt(i) + ((hash << 5) - hash);
    }

    // Generate warna HSL yang pleasant
    const hue = Math.abs(hash % 360);
    const saturation = 60 + (Math.abs(hash >> 8) % 20); // 60-80% untuk tidak terlalu saturated
