<% include ../template-backoffice/header.ejs %>
<!-- Main Content -->
  <div class="main-content">
    <section class="section">
      <div class="section-header">
        <h1>Dashboards</h1>
      </div>

      <div class="section-body">
        <div class="row">
          <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12">
            <div class="card">
              <div class="card-header">

              </div>
              <div class="card-body">
                <div class="row">
                  <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12">
                    <div style="width: 100%;height: 600px;" id="map"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
  <footer class="main-footer">
    <div class="footer-left">
      <% include ../template-backoffice/copyright-left.ejs %>
    </div>
    <div class="footer-right">
      <% include ../template-backoffice/copyright-right.ejs %>

    </div>
  </footer>
<% include ../template-backoffice/footer.ejs %>

<script type="text/javascript">
$(document).ready(function() {

  var iht_layer = null;
  var source = null;
  var marker;
  var center = 0;

  var popupOptions = {
    maxWidth : '450',
    minWidth : '250',
    className : 'custom',
    closeOnClick : true
  };

  var map = L.map('map', {
    center: [ -6.966667, 110.416664],
    zoom: 8,
    minZoom:2,
    maxZoom:19,
    fullscreenControl: true,
    fullscreenControlOptions: {
      position: 'topleft'
    }
  });

  // Base layers
  var osm               = L.tileLayer('https://{s}.tile.osm.org/{z}/{x}/{y}.png', {
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
  });

  var Esri_WorldImagery = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
    attribution: 'Tiles &copy; Esri'
  });

  // Try to add Google layers, but handle errors gracefully
  var google_roadmap = null;
  var google_hybrid = null;
  var google_satelit = null;

  try {
    google_roadmap = L.gridLayer.googleMutant({
      type: 'roadmap'
    });

    google_hybrid = L.gridLayer.googleMutant({
      type: 'hybrid'
    });

    google_satelit = L.gridLayer.googleMutant({
      type: 'satellite'
    });
  } catch(e) {
    console.log("Google Maps layer not available:", e.message);
  }

  var RBI = null;
  try {
    RBI = L.esri.tiledMapLayer({
      url: "https://portal.ina-sdi.or.id/arcgis/rest/services/IGD/RupabumiIndonesia/MapServer"
    });
  } catch(e) {
    console.log("RBI layer not available:", e.message);
  }

  (function(){
    var originalInitTile = L.GridLayer.prototype._initTile
    L.GridLayer.include({
      _initTile: function (tile) {
        originalInitTile.call(this, tile);

        var tileSize = this.getTileSize();

        tile.style.width = tileSize.x + 1 + 'px';
        tile.style.height = tileSize.y + 1 + 'px';
      }
    });
  })();

  // Add default layer
  map.addLayer(osm);

  // TopoJSON support
  L.TopoJSON = L.GeoJSON.extend({
    addData: function(jsonData) {
      if (jsonData.type === "Topology") {
        for (key in jsonData.objects) {
          geojson = topojson.feature(jsonData, jsonData.objects[key]);
          L.GeoJSON.prototype.addData.call(this, geojson);
        }
      }
      else {
        L.GeoJSON.prototype.addData.call(this, jsonData);
      }
    }
  });

  // Layer inisialisasi
  var wellmaxzoom = 13;
  var jateng_kemendagri_layer = new L.GeoJSON();
  var inovasi = new L.TopoJSON();
  var inovasi_markers = L.markerClusterGroup();
  var popup = new L.popup();

  // Fungsi untuk load GeoJSON inovasi
  function loadGeoJsoninovasi(data) {
    try {
      if (!data || !data.objects) {
        console.log("No inovasi data available");
        return;
      }

      inovasi.clearLayers();
      inovasi.addData(data);
      inovasi.addTo(map);

      var i = 0;
      var labelnya = "";

      inovasi.eachLayer(function (layer) {
        var icon = new L.Icon.Default();
        icon.options.shadowSize = [0,0];
        layer.setIcon(icon);
        inovasi_markers.addLayer(layer);

        var popupContent = "Judul : <a href='inovasi/detail/"+layer.feature.properties.id+"'>"+layer.feature.properties.judul_inovasi+"</a>";
        popupContent = popupContent+"</br>Kategori : "+layer.feature.properties.sub_kategori;
        popupContent = popupContent+"</br>Jenis  : "+layer.feature.properties.jenisnya;

        var foto = layer.feature.properties.foto1;
        popupContent = popupContent+'<img src="/foto/'+foto+'" class="img-responsive" style="height: 100px;"> ';

        i++;

        layer.on("click", function (e) {
          popup.setLatLng(layer.getLatLng());
          popup.setContent(popupContent);
          map.openPopup(popup);
        });
      });

      map.removeLayer(inovasi);
      map.addLayer(inovasi_markers);
    } catch(e) {
      console.log("Error loading inovasi data:", e.message);
    }
  }

  // Fungsi untuk load GeoJSON jateng_kemendagri
  function loadGeoJsonjateng_kemendagri(data) {
    try {
      if (!data || !data.features) {
        console.log("No jateng_kemendagri data available");
        return;
      }

      jateng_kemendagri_layer.clearLayers();
      jateng_kemendagri_layer.addData(data);
      jateng_kemendagri_layer.addTo(map);

      var style_jateng = {
        color: "#0066cc",
        weight: 2,
        opacity: 0.8,
        fillColor: "#0066cc",
        fillOpacity: 0.1
      };

      jateng_kemendagri_layer.eachLayer(function (layer) {
        try {
          layer.setStyle(style_jateng);

          // Event listener untuk hover
          layer.on('mouseover', function (e) {
            try {
              this.setStyle({
                weight: 3,
                color: "#ff6600",
                fillColor: "#ff6600",
                fillOpacity: 0.3
              });

              // Ambil data anggota berdasarkan kdpkab
              var kdpkab = layer.feature.properties.kdpkab;

              if (kdpkab) {
                $.ajax({
                  type: "GET",
                  url: rooturl + "/peta/anggota_by_kota?kode_kota=" + kdpkab,
                  dataType: 'json',
                  success: function (anggotaData) {
                    if (anggotaData && anggotaData.status === 200) {
                      var popupContent = "<div style='max-height:300px; overflow-y:auto;'>";
                      popupContent += "<strong>" + (layer.feature.properties.wadmkk || 'Unknown') + "</strong><br/>";
                      popupContent += "Kode Kota: " + kdpkab + "<br/><br/>";

                      // Tampilkan anggota per kualifikasi
                      if (anggotaData.data) {
                        for (var kualifikasi in anggotaData.data) {
                          var anggotas = anggotaData.data[kualifikasi];
                          if (anggotas && anggotas.length > 0) {
                            popupContent += "<strong>" + kualifikasi + "</strong> (" + anggotas.length + ")<br/>";

                            // Tampilkan maksimal 5 anggota per kualifikasi
                            anggotas.slice(0, 5).forEach(function(anggota) {
                              popupContent += "• " + (anggota.nama_perusahaan || 'Unknown');
                              if (anggota.penanggung_jawab) {
                                popupContent += " (" + anggota.penanggung_jawab + ")";
                              }
                              popupContent += "<br/>";
                            });

                            if (anggotas.length > 5) {
                              popupContent += "... dan " + (anggotas.length - 5) + " lainnya<br/>";
                            }
                            popupContent += "<br/>";
                          }
                        }
                      }

                      popupContent += "Total: " + (anggotaData.total || 0) + " anggota";
                      popupContent += "</div>";

                      layer.bindPopup(popupContent, {
                        maxWidth: 350,
                        maxHeight: 400
                      }).openPopup();
                    }
                  },
                  error: function (error) {
                    console.log("Error fetching anggota data:", error);
                  }
                });
              }
            } catch(e) {
              console.log("Error in mouseover handler:", e.message);
            }
          });

          // Event listener untuk mouseout (reset style)
          layer.on('mouseout', function (e) {
            this.setStyle(style_jateng);
          });

          // Event listener untuk click
          layer.on('click', function (e) {
            var kdpkab = layer.feature.properties.kdpkab;

            if (kdpkab) {
              $.ajax({
                type: "GET",
                url: rooturl + "/peta/anggota_by_kota?kode_kota=" + kdpkab,
                dataType: 'json',
                success: function (anggotaData) {
                  if (anggotaData && anggotaData.status === 200) {
                    var popupContent = "<div style='max-height:400px; overflow-y:auto;'>";
                    popupContent += "<strong>" + (layer.feature.properties.wadmkk || 'Unknown') + "</strong><br/>";
                    popupContent += "Kode Kota: " + kdpkab + "<br/><br/>";

                    // Tampilkan anggota per kualifikasi
                    if (anggotaData.data) {
                      for (var kualifikasi in anggotaData.data) {
                        var anggotas = anggotaData.data[kualifikasi];
                        if (anggotas && anggotas.length > 0) {
                          popupContent += "<strong>" + kualifikasi + "</strong> (" + anggotas.length + ")<br/>";

                          anggotas.forEach(function(anggota) {
                            popupContent += "• " + (anggota.nama_perusahaan || 'Unknown');
                            if (anggota.penanggung_jawab) {
                              popupContent += " (" + anggota.penanggung_jawab + ")";
                            }
                            if (anggota.nomor_hp_pjbu) {
                              popupContent += " - " + anggota.nomor_hp_pjbu;
                            }
                            popupContent += "<br/>";
                          });
                          popupContent += "<br/>";
                        }
                      }
                    }

                    popupContent += "Total: " + (anggotaData.total || 0) + " anggota";
                    popupContent += "</div>";

                    layer.bindPopup(popupContent, {
                      maxWidth: 400,
                      maxHeight: 450
                    }).openPopup();
                  }
                }
              });
            }
          });
        } catch(e) {
          console.log("Error setting up layer events:", e.message);
        }
      });
    } catch(e) {
      console.log("Error loading jateng_kemendagri data:", e.message);
    }
  }

  // Load data peta
  async function get_peta(params) {
    try {
      // Load data inovasi
      var geoJsonUrl = rooturl + "/peta/inovasi";
      await  $.getJSON(geoJsonUrl)
        .done(loadGeoJsoninovasi)
        .fail(function(error) {
          console.log("Error loading inovasi:", error);
        });
    } catch(e) {
      console.log("Error in get_peta:", e.message);
    }
  }

  // Fungsi untuk load data jateng_kemendagri saat map siap
  function loadJatengKemendagri() {
    try {
      var geoJsonUrl = rooturl + "/peta/json_jateng_kemendagri";

      $.getJSON(geoJsonUrl)
        .done(loadGeoJsonjateng_kemendagri)
        .fail(function(error) {
          console.log("Error loading jateng_kemendagri:", error);
        });
    } catch(e) {
      console.log("Error in loadJatengKemendagri:", e.message);
    }
  }

  get_peta();

  // Load data jateng_kemendagri setelah map siap
  setTimeout(loadJatengKemendagri, 1000);

  // Base layers - hanya tambahkan layer yang tidak null
  var baseLayers = {
    "Open Street Map": osm,
    "ESRI World Imagery": Esri_WorldImagery
  };

  // Tambahkan Google layers jika tersedia
  if (google_roadmap) baseLayers["Google Roadmap"] = google_roadmap;
  if (google_hybrid) baseLayers["Google Hybrid"] = google_hybrid;
  if (google_satelit) baseLayers["Google Satellite"] = google_satelit;
  if (RBI) baseLayers["RBI"] = RBI;

  // Grouped overlays - pastikan layer terinisialisasi
  var groupedOverlays = {
    "Administrasi": {},
    "Layer": {}
  };

  // Tambahkan layer hanya jika sudah terinisialisasi
  if (typeof jateng_kemendagri_layer !== 'undefined') {
    groupedOverlays["Administrasi"]["&nbsp;&nbsp;&nbsp;&nbsp;Jateng Kemendagri"] = jateng_kemendagri_layer;
  }

  if (typeof inovasi_markers !== 'undefined') {
    groupedOverlays["Layer"]["<span>Inovasi</span>&nbsp;&nbsp;<span style=';padding:2px 8px 2px 8px;'></span>"] = inovasi_markers;
  }

  var options = {
    collapsed: true,
    groupCheckboxes: false
  };

  // Hanya tambahkan kontrol jika ada overlay yang valid
  if (Object.keys(groupedOverlays["Administrasi"]).length > 0 || Object.keys(groupedOverlays["Layer"]).length > 0) {
    try {
      L.control.groupedLayers(baseLayers, groupedOverlays, options).addTo(map);
    } catch(e) {
      console.log("Error adding grouped layers control:", e.message);
      // Fallback ke simple layer control
      L.control.layers(baseLayers).addTo(map);
    }
  } else {
    L.control.layers(baseLayers).addTo(map);
  }

  L.control.scale({
    position : 'bottomright',
    metric : true,
    imperial : false
  }).addTo(map);

  // Locate control dengan error handling
  try {
    var locateIcon = L.ExtraMarkers.icon({
      icon: 'fa-map-marker',
      markerColor: 'blue-dark',
      prefix: 'fa',
      iconColor: 'white',
      shape: 'square'
    });

    var lc = L.control.locate({
      position : 'topleft',
      follow : true,
      strings : {
        title: "Lokasi Anda",
        popup: "Anda berada di radius {distance} {unit} dari titik ini"
      },
      markerClass : L.marker,
      markerStyle : {icon: locateIcon},
      keepCurrentZoomLevel : true
    }).addTo(map);

    map
      .on('startfollowing', function() {
        map.on('dragstart', lc._stopFollowing, lc);
      })
      .on('stopfollowing', function() {
        map.off('dragstart', lc._stopFollowing, lc);
      });
  } catch(e) {
    console.log("Locate control not available:", e.message);
  }

});
</script>