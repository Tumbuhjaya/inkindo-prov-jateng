async function get_chart_tahunan(params) {
  let tahun=$('#tahun').val()||new Date().getFullYear()
let data7 = await $.post('/api/chart_tagihan',{tahun})
$('#tahun_chart2').html(tahun)
console.log(data7);
// Fungsi untuk mengkonversi data API ke format yang dibutuhkan CanvasJS
function prepareChartData(dataArray, months = 12) {
    // Inisialisasi array dengan 12 bulan (nilai default 0)
    let chartData = Array.from({length: months}, (_, index) => ({
        label: getMonthName(index + 1),
        y: 0
    }));

    // Isi data dari API jika ada
    if (dataArray && dataArray.length > 0) {
        dataArray.forEach(item => {
            if (item.label && item.label >= 1 && item.label <= 12) {
                chartData[item.label - 1].y = item.y || 0;
            }
        });
    }

    return chartData;
}

// Fungsi untuk mendapatkan nama bulan
function getMonthName(monthNumber) {
    const months = [
        "Januari", "Februari", "Maret", "April", "Mei", "Juni",
        "Juli", "Agustus", "September", "Oktober", "November", "Desember"
    ];
    return months[monthNumber - 1] || monthNumber;
}

// Siapkan data untuk chart
let dataB = prepareChartData(data7.dataB);
let dataM = prepareChartData(data7.dataM);
let dataK = prepareChartData(data7.dataK);

var chart2 = new CanvasJS.Chart("chartContainer2", {
    animationEnabled: true,
    backgroundColor: "",
    axisY: {
        labelFontWeight: "bold",
        labelFontSize: 14,
        // Format angka dengan pemisah ribuan
        labelFormatter: function(e) {
            return e.value.toLocaleString('id-ID');
        }
    },
    axisX: {
        labelFontWeight: "bold",
        labelFontSize: 14,
    },
    toolTip: {
        shared: true,
        content: function(e) {
            let content = "<span style='font-weight:bold;'>" + e.entries[0].dataPoint.label + "</span><br/>";
            e.entries.forEach(entry => {
                content += "<span style='color:" + entry.dataSeries.color + ";'>●</span> " + 
                          entry.dataSeries.name + ": Rp " + entry.dataPoint.y.toLocaleString('id-ID') + "<br/>";
            });
            return content;
        }
    },
    legend: {
        cursor: "pointer",
        itemclick: toggleDataSeries
    },
    data: [{
        type: "column",
        name: "Kecil",
        color: "#ffa426",
        showInLegend: true,
        dataPoints: dataK // Data untuk Kecil (K)
    },
    {
        type: "column",
        name: "Menengah",
        color: "#63ed7a",
        showInLegend: true,
        dataPoints: dataM // Data untuk Menengah (M)
    },
    {
        type: "column",
        name: "Besar",
        color: "#fc544b",
        showInLegend: true,
        dataPoints: dataB // Data untuk Besar (B)
    }]
});

// Fungsi toggle legend (perlu didefinisikan)
function toggleDataSeries(e) {
    if (typeof (e.dataSeries.visible) === "undefined" || e.dataSeries.visible) {
        e.dataSeries.visible = false;
    } else {
        e.dataSeries.visible = true;
    }
    chart2.render();
}

chart2.render();
}
