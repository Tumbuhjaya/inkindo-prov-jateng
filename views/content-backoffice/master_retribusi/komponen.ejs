<div class="section-body">
  <div class="row">
    <div class="col-12 col-lg-12 col-xl-12">
      <div class="card">
        <div class="card-body">
          <div class="form-group row mb-0">
            <label class="col-sm-3 col-form-label">Nama Retribusi</label>
            <div class="col-sm-9">
              <input type="text" class="form-control" id="nama_retribusi" name="nama_retribusi" required>
            </div>
          </div>

          <hr>

          <div class="form-group row mb-0">
            <label class="col-sm-3 col-form-label">Jumlah</label>
            <div class="col-sm-9">
              <input type="number" class="form-control" id="jumlah" name="jumlah" >
            </div>
          </div>

          <hr>

          <div class="form-group row mb-0">
            <label class="col-sm-3 col-form-label">Periode</label>
            <div class="col-sm-9">
              <select name="periode" class="form-control select2" id="periode">
                <option value="">-- Pilih --</option>
                <option value="Bulanan">Bulanan</option>
                <option value="Tahunan">Tahunan</option>
                <option value="Sekali Bayar">Sekali Bayar</option>
              </select>
            </div>
          </div>

          <hr>

          <div class="form-group row mb-0">
            <label class="col-sm-3 col-form-label">Status</label>
            <div class="col-sm-9">
              <select name="status" class="form-control select2" id="status">
                <option value="">-- Pilih --</option>
                <option value="Aktif">Aktif</option>
                <option value="Tidak Aktif">Tidak Aktif</option>
              </select>
            </div>
          </div>

          <hr>

          <div class="form-group row mb-0">
            <label class="col-sm-3 col-form-label">Keterangan</label>
            <div class="col-sm-9">
              <textarea class="form-control" id="keterangan" name="keterangan" rows="3"></textarea>
            </div>
          </div>

          <hr>

          <div class="form-group row mb-0">
            <div class="col-sm-9 offset-sm-3">
              <div id="button_submit">
                <button class="btn btn-primary mb-0 btn-lg" onclick="submit()">Submit</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>