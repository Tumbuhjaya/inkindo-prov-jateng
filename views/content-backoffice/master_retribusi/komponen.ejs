<div class="section-body">
  <div class="row">
    <div class="col-12 col-lg-12 col-xl-12">
      <div class="card">
        <div class="card-body">
          <div class="form-group row mb-0">
            <label class="col-sm-3 col-form-label">Kualifikasi</label>
            <div class="col-sm-9">
              <select name="kualifikasi" class="form-control select2" id="kualifikasi" required>
                <option value="">-- Pilih --</option>
                <option value="B">Besar (B)</option>
                <option value="M">Menengah (M)</option>
                <option value="K">Kecil (K)</option>
              </select>
            </div>
          </div>

          <hr>

          <div class="form-group row mb-0">
            <label class="col-sm-3 col-form-label">Nominal</label>
            <div class="col-sm-9">
              <input type="text" class="form-control input-with-thousand-separator" 
       name="nominal" id="nominal" 
       placeholder="Contoh: 1.500.000" 
       oninput="formatRupiah(this)" 
       required>
            </div>
          </div>

          <hr>

          <div class="form-group row mb-0">
            <div class="col-sm-9 offset-sm-3">
              <div id="button_submit">
                <button class="btn btn-primary mb-0 btn-lg" onclick="submit()">Submit</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
function formatRupiah(input) {
    // Handle both input element and string value
    let value;
    if (typeof input === 'string') {
        value = input;
    } else if (input && typeof input.value !== 'undefined') {
        value = input.value;
    } else {
        return '';
    }
    
    // Hapus semua karakter non-digit
    value = value.replace(/\D/g, '');
    
    // Jika kosong, set value kosong
    if (value === '') {
        return '';
    }
    
    // Konversi ke number
    let number = parseInt(value);
    
    // Format dengan pemisah ribuan
    let formatted = number.toLocaleString('id-ID');
    
    // If input is a string, return formatted string
    if (typeof input === 'string') {
        return formatted;
    }
    
    // If input is an element, set its value
    input.value = formatted;
}
function getRawValue(inputId) {
    const element = document.getElementById(inputId);
    if (!element) return 0;
    
    // Hapus semua karakter non-digit
    const raw = element.value.replace(/\./g, '').replace(/\D/g, '');
    console.log(raw);
    
    return raw === '' ? 0 : parseInt(raw);
}
</script>