<% include ../../template-backoffice/footer.ejs %>
<script type="text/javascript">
  var rooturl = ''
  let retribusi = {}
  window.onload =async function (params) {
    await $.get(rooturl+'/master/retribusi/list?id=<%=id%>').then(function (data) {
      retribusi = data.data[0]
      console.log(retribusi);
      for (const i in retribusi) {
        if (Object.hasOwnProperty.call(retribusi, i)) {
          if(i=='kualifikasi'){
            $('#'+i).val(retribusi[i]).select2()
          }else{
            $('#'+i).val(retribusi[i])
          }
        }
      }
    })
  }

  async function submit() {
    const will_update = await swal({
      title: "Edit Data",
      text: "Apakah anda akan mengedit data ini?",
      icon: "warning",
      dangerMode: true,
      buttons: ["Tidak", "Ya"],
    });        
    
    if ( will_update) {
      $('#button_submit').empty()
      $('#button_submit').append('<button class="btn btn-primary btn-embossed" disabled>Simpan</button>')
    
      let formData = new FormData();
      // nama kolom db
      let arr = ['kualifikasi', 'nominal']

      formData.append('id', retribusi.id);

      for (let i = 0; i < arr.length; i++) {
        if ($('#'+arr[i]).val()) {
          formData.append(arr[i],$('#'+arr[i]).val())
        }
      }

      $.ajax({
        type: 'POST',
        enctype: 'multipart/form-data',
        url: rooturl+'/master/retribusi/edit',
        data: formData,
        processData: false,
        contentType: false,
        success: function(data) {
          swal({title:text_edit.title,text:text_edit.text, icon: text_edit.icon, type:text_edit.type})
          window.location.href = rooturl+'/master/retribusi';
        },error: function(data) {
          swal({title:text_error.title,text:text_error.text, icon: text_error.icon, type:text_error.type})
        }
      })      
    } 
  }
</script>