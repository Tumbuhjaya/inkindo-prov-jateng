<script type="text/javascript">
  var rooturl = ''

  async function submit() {
    const will_insert = await swal({
      title: "Tambah Data",
      text: "Apakah anda akan menambahkan data ini?",
      icon: "warning",
      dangerMode: true,
      buttons: ["Tidak", "Ya"],
    });

    if ( will_insert) {
      $('#button_submit').empty()
      $('#button_submit').append('<button class="btn btn-primary btn-embossed" disabled>Simpan</button>')
      
      let formData = new FormData();
      // nama kolom db
      let arr = ['nama_retribusi', 'jumlah', 'periode', 'status', 'keterangan']

      for (let i = 0; i < arr.length; i++) {
        if ($('#'+arr[i]).val()) {
          formData.append(arr[i],$('#'+arr[i]).val())
        }
      }

      $.ajax({
        type: 'POST',
        enctype: 'multipart/form-data',
        url: rooturl+'/master/spesialisasi/insert',
        data: formData,
        processData: false,
        contentType: false,
        success: function(data) {
          if (data.status == 201) {
            swal({title:text_error.title,text:data.data, icon: text_error.icon, type:text_error.type})
          }else{
            swal({title:text_insert.title,text:text_insert.text, icon: text_insert.icon, type:text_insert.type})
            window.location.href = rooturl+'/master/spesialisasi';
          }
        },error: function(data) {
          swal({title:text_error.title,text:text_error.text, icon: text_error.icon, type:text_error.type})
        }
      })      
    } 
  }
</script>