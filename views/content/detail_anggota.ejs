    <script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>
    <script src="<%= rooturl %>/javascripts/template/bootstrap.bundle.js"></script>
    <!-- Plugins This Page -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.6-rc.0/js/select2.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.22/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.22/js/dataTables.bootstrap4.min.js"></script>
    <!-- End Plugins This Page -->
    <script type="text/javascript">
        var rooturl = '';
        const searchContainer = document.getElementById('searchContainer');
        const searchBtn = document.getElementById('searchBtn');
        const searchInput = document.getElementById('searchInput');

        // Menambahkan event listener saat tombol diklik
        searchBtn.addEventListener('click', () => {
            const searchValue = searchInput.value.trim();

            if (searchValue && searchContainer.classList.contains('active')) {
                // Jika ada nilai pencarian dan container aktif, redirect ke halaman detail dengan pencarian
                window.location.href = rooturl + '/data/search?q=' + encodeURIComponent(searchValue);
            } else {
                // Mengubah status class 'active' (tambah jika belum ada, hapus jika sudah ada)
                searchContainer.classList.toggle('active');

                // Jika container terbuka, fokuskan kursor ke dalam input secara otomatis
                if (searchContainer.classList.contains('active')) {
                    searchInput.focus();
                }
            }
        });

        // Event listener untuk Enter key di search input
        searchInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter' && searchInput.value.trim()) {
                window.location.href = rooturl + '/data/search?q=' + encodeURIComponent(searchInput.value.trim());
            }
        });

        var anggotaId = <%= (typeof anggotaId !== 'undefined') ? anggotaId : 'null' %>;

        function formatRupiah(amount) {
            if (amount === null || amount === undefined || isNaN(amount)) {
                return 'Rp 0,-';
            }
            const num = Number(amount);
            const formatted = num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');
            return `Rp ${formatted},-`;
        }

        function formatDate(dateString) {
            if (!dateString) return '-';
            const date = new Date(dateString);
            return date.toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric' });
        }

        function getKualifikasiText(kualifikasi) {
            const kualifikasiMap = {
                'B': 'Besar',
                'M': 'Menengah',
                'K': 'Kecil',
            };
            return kualifikasiMap[kualifikasi] || kualifikasi || '-';
        }

        function getStatusBadge(status) {
            if (status === 'P') {
                return '<span class="badge-status badge-active">Aktif</span>';
            } else if (status === 'T') {
                return '<span class="badge-status badge-inactive">Non Aktif</span>';
            } else if (status === 'Pending') {
                return '<span class="badge-status badge-pending">Pending</span>';
            }
            return status || '-';
        }

        async function loadAnggotaDetail() {
            if (!anggotaId) {
                $('#loadingIndicator').hide();
                $('#errorMessage').show();
                return;
            }

            try {
                // Load anggota data
                const anggotaResponse = await $.get(rooturl + '/anggota/' + anggotaId);

                if (anggotaResponse.status !== 200 || !anggotaResponse.data) {
                    $('#loadingIndicator').hide();
                    $('#errorMessage').show();
                    return;
                }

                const anggota = anggotaResponse.data;
                if (anggota.foto_1) {
                    $('#foto').empty()
                    $('#foto').append(`<img src="/foto/${anggota.foto_1}" alt="" style="width: 100%;">`)

                }
                // Populate company info
                $('#no_anggota').text(anggota.no_anggota || '-');
                $('#nama_perusahaan').text(anggota.nama_perusahaan || '-');
                $('#penanggung_jawab').text(anggota.penanggung_jawab || '-');
                $('#gelar_pjbu').text(anggota.gelar_pjbu || '-');
                $('#tanggal_lahir').text(formatDate(anggota.tanggal_lahir));
                $('#alamat').text(anggota.alamat || '-');
                $('#kota').text(anggota.kota || '-');
                $('#korwil').text(anggota.korwil || '-');
                $('#no_sertifikat').text(anggota.no_sertifikat || '-');

                // Populate contact info
                $('#telepon').text(anggota.telepon || '-');
                $('#fax').text(anggota.fax || '-');
                $('#nomor_hp_pjbu').text(anggota.nomor_hp_pjbu || '-');
                $('#email_kta').text(anggota.email_kta || '-');

                // Populate membership info
                $('#status_keanggotaan').html(getStatusBadge(anggota.status_keanggotaan));
                $('#kualifikasi').text(getKualifikasiText(anggota.kualifikasi));
                $('#tahun_masuk').text(anggota.tahun_masuk || '-');
                $('#spesialisasi').text(anggota.spesialisasi || '-');
                $('#jumlah_tunggakan').text(formatRupiah(anggota.tunggakan));

                // Load payment history
                const paymentResponse = await $.get(rooturl + '/anggota/pembayaran/' + anggotaId + '/list');

                if (paymentResponse.status === 200 && paymentResponse.data) {
                    const paymentTableBody = $('#paymentTableBody');
                    paymentTableBody.empty();

                    paymentResponse.data.forEach(function(payment) {
                        const statusBadge = payment.status == 1
                            ? '<span class="badge-status badge-active">Lunas</span>'
                            : '<span class="badge-status badge-inactive">Belum Lunas</span>';

                        paymentTableBody.append(`
                            <tr>
                                <td>${payment.tahun || '-'}</td>
                                <td>${formatDate(payment.tanggal_pembayaran)}</td>
                                <td>${formatRupiah(payment.retribusi)}</td>
                                <td>${statusBadge}</td>
                            </tr>
                        `);
                    });

                    if (paymentResponse.data.length === 0) {
                        paymentTableBody.append('<tr><td colspan="4" class="text-center">Tidak ada data pembayaran</td></tr>');
                    }
                }

                // Hide loading, show content
                $('#loadingIndicator').hide();
                $('#detailContent').fadeIn();

            } catch (error) {
                console.log('Error loading anggota detail:', error);
                $('#loadingIndicator').hide();
                $('#errorMessage').show();
            }
        }

        // Load data on page ready
        $(document).ready(function() {
            loadAnggotaDetail();
        });

        let data_table =   $('#data').DataTable({    
        "language": {    
          "sProcessing":   "Sedang memproses...",    
          "sLengthMenu":   "_MENU_",    
          "sZeroRecords":  "Tidak ditemukan data yang sesuai",    
          "sInfo":         "Menampilkan _START_ sampai _END_ dari _TOTAL_ entri",    
          "sInfoEmpty":    "Menampilkan 0 sampai 0 dari 0 entri",    
          "sInfoFiltered": "(disaring dari _MAX_ entri keseluruhan)",    
          "sInfoPostFix":  "",    
          "sUrl":          "",    
          "oPaginate": {    
            "sFirst":    "Pertama",    
            "sPrevious": "Sebelumnya",    
            "sNext":     "Selanjutnya",    
            "sLast":     "Terakhir"    
          }    
        },    
        "processing": true,
        // "ajax":  `${rooturl}/anggota/list`,
        // "columns": [
        //     { "data": null},
        //     {
        //         "data": "nama_perusahaan",
        //         "render": function(data, type, row) {
        //             return '<a href="/data/anggota/' + row.id + '" style="text-decoration: none; font-weight: bold;color:#1F3163">' + data + '</a>';
        //         }
        //     },
        //     { "data": "penanggung_jawab"},
        //     { "data": "telepon"},
        //     { "data": "kualifikasi",render:function(data){return data=='B'?'BESAR':data=='M'?'MENENGAH':'KECIL'}},
        //     {
        //         "data": "spesialisasi",
        //         "render": function(data, type, row) {
        //             return '<span style="text-transform:uppercase">' + data + '</span>';
        //         }
        //     },
        //     { "data": "status"}
        // ],
        // // "columnDefs": [
        // //   { "width": "35px", "targets": 0},
        // //   { "width": "100px", "targets": 2}
        // // ],
      });
    </script>
</body>
</html>