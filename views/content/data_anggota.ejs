    $('#searchKualifikasi').val('').trigger('change');
    $('#searchStatus').val('').trigger('change');
    $('#searchSpesialisasi').val('').trigger('change');

    // Reload table without filters
    data_table.ajax.url(rooturl + '/anggota/list').load(function() {
        // Get total records
        const totalRecords = data_table.page.info().recordsDisplay;
        // Update badge with total records
        $('#filterCountNumber').text(totalRecords.toString().padStart(2, '0'));
        // Show the badge
        $('#filterCount').show();
    });
}
      // Load master spesialisasi data
     async function loadSpesialisasi() {
    try {
        const response = await $.get('/master/spesialisasi/list');
        if (response.status === 200 && response.data) {
            const select = $('#searchSpesialisasi');
            select.empty();
            
            // Catatan: Untuk multiple select dengan Select2, sebaiknya tidak pakai placeholder berbentuk <option> kosong statis.
            // Kita akan mengatur placeholder langsung lewat konfigurasi Select2 di bawah.

            response.data.forEach(function(item) {
                select.append('<option value="' + item.id + '">' + item.nama_spesialisasi + '</option>');
            });

            // --- INI KUNCI PERBAIKANNYA ---
            // Inisialisasi Select2 setelah data selesai dimasukkan
            select.select2({
                placeholder: "-- Pilih Spesialisasi --",
                allowClear: true,
                width: '100%' // Memastikan lebar dropdown mengikuti pembungkus Bootstrap
            });
        }
    } catch (error) {
        console.log('Error loading spesialisasi:', error);
    }
}

// Pastikan fungsi ini dipanggil saat dokumen siap
$(document).ready(function() {
    loadSpesialisasi();
});
      // Load spesialisasi data on page load
      loadSpesialisasi();

      data_table.on( 'draw.dt', function () {
        let PageInfo = $('#data').DataTable().page.info();
        data_table.column(0, { page: 'current' }).nodes().each( function (cell, i) {
            cell.innerHTML = i + 1 + PageInfo.start;
        } );
      });

       
    </script>
