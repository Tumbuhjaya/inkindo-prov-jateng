    <style type="text/css">
        .w-100{
            width: 100%;
        }

        .w-100-flex{
            width: 100%;
            display: flex;
        }

        h1,h2,h3,h4,h4,h5,h6{
            margin: 0;
        }

        /* Container untuk search box */
        .search-container {
            position: relative;
            background-color: #ffffff;
            border-radius: 50px;
            padding: 5px;
            display: flex;
            align-items: center;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            transition: 0.4s ease;
        }

        /* Styling untuk input text (awalnya disembunyikan) */
        .search-input {
            border: none;
            background: none;
            outline: none;
            width: 0; /* Lebar awal 0 agar tidak terlihat */
            padding: 0;
            font-size: 16px;
            color: #333;
            transition: width 0.4s ease, padding 0.4s ease; /* Efek animasi slide */
        }

        /* Styling saat class 'active' ditambahkan lewat JavaScript */
        .search-container.active .search-input {
            width: 300px; /* Lebar saat terbuka */
            padding: 0 15px; /* Menambah jarak teks ke tombol */
        }

        /* Styling untuk tombol pencarian */
        .search-btn {
            background-color: #1F3163;
            color: white;
            border: none;
            width: 35px;
            height: 35px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            transition: background-color 0.3s;
            font-size: 18px;
        }

        .search-btn:hover {
            background-color: #68A9C8;
        }

        .btn-primary {
            color: #fff;
            background-image: linear-gradient(160deg, #1F3163 25%, #68A9C8 100%);
            border-color: #68A9C8;
        }

        .page-item.active .page-link{
            background-color: #1F3163;
        }
        
        .table-striped tbody tr:nth-of-type(odd){
            background-color: rgba(104, 169, 200, 0.5);
        }

        .gradient-text {
          /* 1. Buat background dengan warna gradasi */
          background: linear-gradient(135deg, #1F3163 15%, #68A9C8 100%);

          /* 2. Potong background mengikuti bentuk karakter teks */
          -webkit-background-clip: text;
          background-clip: text;

          /* 3. Buat warna teks bawaan menjadi transparan agar gradasi terlihat */
          -webkit-text-fill-color: transparent;
          color: transparent;
        } 

        #data td{
            text-transform: uppercase;
        }
    </style>
