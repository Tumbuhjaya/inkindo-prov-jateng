      const searchContainer = document.getElementById('searchContainer');
        const searchBtn = document.getElementById('searchBtn');
        const searchInput = document.getElementById('searchInput');

        // Menambahkan event listener saat tombol diklik
        searchBtn.addEventListener('click', () => {
            const searchValue = searchInput.value.trim();

            if (searchValue && searchContainer.classList.contains('active')) {
                // Jika ada nilai pencarian dan container aktif, redirect ke halaman detail dengan pencarian
                window.location.href = rooturl + '/data/search?q=' + encodeURIComponent(searchValue);
            } else {
                // Mengubah status class 'active' (tambah jika belum ada, hapus jika sudah ada)
                searchContainer.classList.toggle('active');

                // Jika container terbuka, fokuskan kursor ke dalam input secara otomatis
                if (searchContainer.classList.contains('active')) {
                    searchInput.focus();
                }
            }
        });

        // Event listener untuk Enter key di search input
        searchInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter' && searchInput.value.trim()) {
                window.location.href = rooturl + '/data/search?q=' + encodeURIComponent(searchInput.value.trim());
            }
        });

        function formatRupiah(amount) {
    // Handle null, undefined, or non-number inputs
    if (amount === null || amount === undefined || isNaN(amount)) {
        return 'Rp 0,-';
    }
    
    // Ensure it's a number
    const num = Number(amount);
    
    // Format with dots
    const formatted = num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');
    
    return `Rp ${formatted},-`;
}

